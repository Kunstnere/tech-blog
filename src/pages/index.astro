---
import { ArrowDown, Github } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/posts";
import { site } from "../data/site";

const posts = await getPublishedPosts();
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span></span>技术随笔与工程记录</p>
      <h1>把解决过的问题，<br />写成下一次的答案。</h1>
      <p class="hero-description">{site.description}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#latest">
          开始阅读
          <ArrowDown size={16} stroke-width={1.8} />
        </a>
        <a class="button button-secondary" href="https://github.com/" target="_blank" rel="noreferrer">
          <Github size={16} stroke-width={1.8} />
          查看代码
        </a>
      </div>
    </div>

    <aside class="hero-note" aria-label="博客说明">
      <p class="note-label">NOTE / 01</p>
      <p class="note-title">不追逐更新数量，<br />只记录值得留下的东西。</p>
      <div class="note-rule"></div>
      <dl>
        <div>
          <dt>主题</dt>
          <dd>工程实践</dd>
        </div>
        <div>
          <dt>写作</dt>
          <dd>问题驱动</dd>
        </div>
        <div>
          <dt>更新</dt>
          <dd>不定期</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section id="latest" class="latest container" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">LATEST WRITING</p>
        <h2 id="latest-title">最近文章</h2>
      </div>
      <p>{posts.length} 篇公开文章</p>
    </div>

    {
      posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post, index) => (
            <PostCard post={post} index={index} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>第一篇文章正在准备中。</p>
        </div>
      )
    }
  </section>

  <section class="manifesto container">
    <p class="section-kicker">WHY WRITE</p>
    <blockquote>
      “写作不是证明自己已经懂了，<br />
      而是把模糊的理解逼到足够清楚。”
    </blockquote>
    <a class="text-link" href="/about/">了解这个博客</a>
  </section>
</BaseLayout>
