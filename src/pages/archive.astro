---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
const postsByYear = posts.reduce<Record<string, typeof posts>>((groups, post) => {
  const year = String(post.data.pubDate.getFullYear());
  groups[year] ??= [];
  groups[year].push(post);
  return groups;
}, {});
---

<BaseLayout title="文章归档" description="按时间浏览全部公开文章。">
  <section class="page-header container">
    <p class="eyebrow"><span></span>ARCHIVE</p>
    <h1>文章归档</h1>
    <p>共 {posts.length} 篇文章，按发布时间从新到旧排列。</p>
  </section>

  <section class="archive container">
    {
      Object.entries(postsByYear).map(([year, yearPosts]) => (
        <div class="archive-year">
          <h2>{year}</h2>
          <ol>
            {yearPosts.map((post) => (
              <li>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate).replace("年", ".").replace("月", ".").replace("日", "")}
                </time>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>
</BaseLayout>
